// Channel Warper :: channel
//============================================================
function	script	F_IzludeChannel	{
	mes "[채널 이동 담당관]";
	mes "이즈루드는 정말 활기찬 도시죠?";
	mes "쾌적한 환경을 위해 채널 이동을 도와드리고 있어요.";
	mes "다른 이즈루드 채널로 이동시켜 드릴 수 있습니다.";
	mes "다른 채널로 이동하시겠습니까?";
	next;
	set .@i, select(getarg(0)+":취소");
	if (.@i < 6) {
		setarray .@maps$[1],"izlude","izlude_a","izlude_b","izlude_c","izlude_d";
		savepoint .@maps$[.@i],128,98,1,1;
		warp .@maps$[.@i],128,98;
		end;
	}
	close;
}
izlude,122,105,5	script	채널 이동 담당관	1_M_WIZARD,{ callfunc "F_IzludeChannel",":2채널로 이동:3채널로 이동:4채널로 이동:5채널로 이동"; }
