// Talking NPCs
//============================================================
izlude,143,205,7	script	수다쟁이 꼬마#iz	4_F_KID2,{
	end;

OnTimer64000:
	npctalk "수다쟁이 꼬마 : 초보자용 빨간 포션을 다 써버렸어. 어떡하지?";
	end;

OnTimer72000:
	npctalk "수다쟁이 꼬마 : 상점은 어디 있지?";
	end;

OnTimer136000:
	npctalk "수다쟁이 꼬마 : 에이, '단축창'도 모르는 거야?";
	end;

OnTimer144000:
	npctalk "수다쟁이 꼬마 : 인벤토리 아이템은 드래그해서 단축창에 올릴 수 있어.";
	end;

OnTimer212000:
	npctalk "수다쟁이 꼬마 : 아카데미에서 초보자 아이템을 엄청 많이 받았어!";
	end;

OnTimer276000:
	npctalk "수다쟁이 꼬마 : 무기랑 방패까지 챙겨줬다니까!";
	end;

OnTimer284000:
	npctalk "수다쟁이 꼬마 : <Ctrl+~키>를 누르면 지도를 열 수 있어.";
	end;

OnTimer344000:
	npctalk "수다쟁이 꼬마 : 그럼 나랑 크리투라 아카데미 갈래? 수비노 선생님한테 전투를 배우고 있어!";
	end;

OnTimer348000:
	npctalk "수다쟁이 꼬마 : 아카데미는 이즈루드 북쪽에 있어. 같이 가자~!";
	end;

OnTimer416000:
	npctalk "수다쟁이 꼬마 : 목적지까지 안내해 주는 시스템이야.";
	end;

OnTimer424000:
	npctalk "수다쟁이 꼬마 : 기본 메뉴에서 [내비게이션] 버튼을 눌러봐.";
	end;

OnTimer492000:
	npctalk "수다쟁이 꼬마 : 우와, 머리는 장식이야? 채팅창에 /where를 쳐봐!";
	end;

OnTimer552000:
	npctalk "수다쟁이 꼬마 : 이럴 땐 <Enter> 키를 누르면 돼.";
	end;

OnTimer560000:
	npctalk "수다쟁이 꼬마 : 우리 지금 같은 말만 반복 중이네. 하하하.";
	end;

OnTimer565000:
OnInit:
	initnpctimer;
	end;
}

